{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lighten-up",
  "version": "0.1.0",
  "identifier": "com.cadams.lighten-up",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "lighten-up",
        "width": 1024,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Lighten Up - P2P office status communication",
      "args": [
        {
          "name": "id",
          "description": "Override peer ID for testing",
          "takesValue": true
        },
        {
          "name": "name",
          "description": "Override peer name",
          "takesValue": true
        },
        {
          "name": "data-dir",
          "description": "Override data directory path for testing",
          "takesValue": true
        }
      ]
    }
  }
}
